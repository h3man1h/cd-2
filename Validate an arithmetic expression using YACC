%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token NUMBER ID

%%
input:
      E { printf("Valid expression\n"); }
    ;

E:
      E '+' E
    | E '-' E
    | E '*' E
    | E '/' E
    | E '%' E
    | '(' E ')'
    | NUMBER
    | ID
    ;
%%

void yyerror(const char *s) {
    printf("Invalid expression\n");
}

int main() {
    printf("Enter expression: ");
    return yyparse();
}
