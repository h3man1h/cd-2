
#include <stdio.h>
#include <ctype.h>
#include <string.h>

char s[200];
int pos = 0, error = 0;

void E();
void T();
void F();

void skip() {
    while (s[pos] == ' ' || s[pos] == '\t')
        pos++;
}

void E() {
    T();
    skip();

    while (s[pos] == '+') {
        pos++;
        T();
        skip();
    }
}

void T() {
    F();
    skip();

    while (s[pos] == '*') {
        pos++;
        F();
        skip();
    }
}

void F() {
    skip();

    if (s[pos] == '(') {
        pos++;
        E();
        skip();

        if (s[pos] == ')')
            pos++;
        else
            error = 1;
    }
    else if (isalnum((unsigned char)s[pos])) {
        while (isalnum((unsigned char)s[pos]))
            pos++;
    }
    else {
        error = 1;
    }
}

int main() {
    printf("Enter expression: ");
    if (!fgets(s, sizeof(s), stdin))
        return 0;

    E();
    skip();

    if (s[pos] != '\0' && s[pos] != '\n')
        error = 1;

    if (error)
        printf("Invalid expression\n");
    else
        printf("Valid expression\n");

    return 0;
}



Input: a+b*c

Output: Valid expression

This parser uses the transformed grammar:
E -> T {+ T}
T -> F {* F}
F -> (E) | id
