%{
#include <stdio.h>
int yylex(void);
void yyerror(const char *s);
%}

%token NUMBER
%left '+' '-'
%left '*' '/' '%'
%right UMINUS

%%
input:
      E { printf("Result = %d\n", $1); }
    ;

E:
      E '+' E  { $$ = $1 + $3; }
    | E '-' E  { $$ = $1 - $3; }
    | E '*' E  { $$ = $1 * $3; }
    | E '/' E  {
          if ($3 == 0) {
              yyerror("Division by zero");
              YYERROR;
          }
          $$ = $1 / $3;
      }
    | E '%' E  { $$ = $1 % $3; }
    | '-' E %prec UMINUS { $$ = -$2; }
    | '(' E ')' { $$ = $2; }
    | NUMBER { $$ = $1; }
    ;
%%

void yyerror(const char *s) {
    printf("Invalid expression or arithmetic error\n");
}

int main() {
    printf("Enter expression: ");
    return yyparse();
}

