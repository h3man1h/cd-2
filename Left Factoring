
#include <stdio.h>
#include <string.h>

int main() {
    char g[200], lhs, rhs[180];
    char p[20][50];
    int n = 0, i, j, k, min, common = 0;

    printf("Enter grammar (e.g. A->ab|ac): ");
    scanf("%199s", g);

    if (g[1] != '-' || g[2] != '>') {
        printf("Invalid grammar\n");
        return 0;
    }

    lhs = g[0];
    strcpy(rhs, g + 3);

    i = 0;
    while (rhs[i] != '\0') {
        j = i;
        while (rhs[j] != '|' && rhs[j] != '\0')
            j++;

        if (n >= 20 || j - i >= 50) {
            printf("Grammar too large\n");
            return 0;
        }

        strncpy(p[n], rhs + i, j - i);
        p[n][j - i] = '\0';
        n++;

        if (rhs[j] == '\0') break;
        i = j + 1;
    }

    if (n < 2) {
        printf("No left factoring needed\n");
        return 0;
    }

    min = strlen(p[0]);
    for (i = 1; i < n; i++)
        if ((int)strlen(p[i]) < min)
            min = strlen(p[i]);

    for (i = 0; i < min; i++) {
        for (j = 1; j < n; j++)
            if (p[j][i] != p[0][i])
                break;

        if (j == n) common++;
        else break;
    }

    if (common == 0) {
        printf("No left factoring needed\n");
        printf("%c->%s\n", lhs, rhs);
        return 0;
    }

    printf("%c->", lhs);
    for (i = 0; i < common; i++)
        printf("%c", p[0][i]);
    printf("%c'\n", lhs);

    printf("%c'->", lhs);
    for (i = 0; i < n; i++) {
        if (i) printf("|");
        printf("%s", p[i] + common);
        if (p[i][common] == '\0')
            printf("#");
    }
    printf("\n");

    return 0;
}


Input: A->ab|ac

Output:
A->aA'
A'->b|c
