%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int yylex(void);
void yyerror(const char *s);

char *join(char *a, char *op, char *b) {
    char *r = malloc(strlen(a) + strlen(b) +
                     strlen(op) + 1);
    strcpy(r, a);
    strcat(r, b);
    strcat(r, op);
    return r;
}
%}

%union {
    char *str;
}

%token <str> ID NUM
%type <str> E
%left '+' '-'
%left '*' '/' '%'
%right UMINUS

%%
input:
      E { printf("Postfix = %s\n", $1); }
    ;

E:
      E '+' E { $$ = join($1, "+", $3); }
    | E '-' E { $$ = join($1, "-", $3); }
    | E '*' E { $$ = join($1, "*", $3); }
    | E '/' E { $$ = join($1, "/", $3); }
    | E '%' E { $$ = join($1, "%", $3); }
    | '-' E %prec UMINUS {
          $$ = join($2, "~", "");
      }
    | '(' E ')' { $$ = $2; }
    | ID { $$ = $1; }
    | NUM { $$ = $1; }
    ;
%%

void yyerror(const char *s) {
    printf("Invalid expression\n");
}

int main() {
    printf("Enter infix expression: ");
    return yyparse();
}


